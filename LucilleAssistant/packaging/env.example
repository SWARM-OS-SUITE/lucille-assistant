# Lucille Assistant environment. Copy to ~/.config/lucille-assistant/.env (install.sh does this)
# and fill in only what you use. Everything is optional; features whose key is missing
# degrade gracefully. NEVER commit or ship the filled-in file.

# Required for any non-loopback caller (phones over Tailscale). Pick a long random string.
SWARM_AUTH_TOKEN=

# Where to listen. ';'-separated. Default is loopback only.
# LUCILLE_ASSISTANT_LISTEN=127.0.0.1:8403;100.x.y.z:8403

# Steam hours / deals
STEAM_API_KEY=
STEAM_ID64=

# Chat / ideas. The easy way to add the OpenRouter and Claude keys is the phone app:
# Config -> "Lucille's brains" (or the web page: Connect -> "Lucille's brains"). Keys entered
# there are kept in ~/.config/lucille-assistant/keys.env (mode 0600) and win over this file.
# They are NEVER read from SWARM OS's own .env files. Order: OpenRouter or Claude (your choice
# in the window), then NVIDIA NIM, then three offline models (see config.json "local_models").
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.6-plus
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5   # small and cheap on purpose; any current Claude model id works
# ANTHROPIC_EFFORT=low               # low|medium|high|xhigh|max, or "none" to send no effort
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Spoken replies
ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Overrides (defaults shown)
# LUCILLE_ASSISTANT_CONFIG=~/.config/lucille-assistant/config.json
# LUCILLE_ASSISTANT_DATA=~/.local/share/lucille-assistant
